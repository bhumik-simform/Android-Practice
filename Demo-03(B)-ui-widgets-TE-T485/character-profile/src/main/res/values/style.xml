<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ProfileImageCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.GotProfile.DisplayName" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/got_profile_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GotProfile.Handle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/got_profile_text_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.GotProfile.Bio" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/got_profile_text_primary</item>
        <item name="lineHeight">22sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.GotProfile.StatNumber" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/got_profile_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GotProfile.StatLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/got_profile_text_secondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.02</item> </style>

    <style name="TextAppearance.GotProfile.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/got_profile_accent_link</item> <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item> <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.GotProfile.TabActive" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/got_profile_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GotProfile.TabInactive" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/got_profile_text_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.GotProfile.PostBody" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/got_profile_text_primary</item>
        <item name="lineHeight">22sp</item>
    </style>

    <style name="TextAppearance.GotProfile.PostLink" parent="TextAppearance.GotProfile.PostBody">
        <item name="android:textColor">@color/got_profile_accent_link</item>
    </style>

</resources>