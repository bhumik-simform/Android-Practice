<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.DishDetailActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_dish_emoji"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#D6CBF3"
        android:padding="16dp"
        app:cardCornerRadius="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="128sp"
            tools:text="🍖" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_dish_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textColor="#000"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/cv_dish_emoji"
        app:layout_constraintTop_toBottomOf="@id/cv_dish_emoji"
        tools:text="BBQ Ribs" />

    <TextView
        android:id="@+id/tv_dish_country"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B0B0B0"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/tv_dish_name"
        app:layout_constraintTop_toBottomOf="@id/tv_dish_name"
        tools:text="USA" />

    <LinearLayout
        android:id="@+id/linear_layout_detail_tags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@id/tv_dish_name"
        app:layout_constraintTop_toBottomOf="@id/tv_dish_country">

        <TextView
            android:id="@+id/tv_dish_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_detail_card"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:textColor="#F84E4E"
            android:textSize="16sp"
            tools:text="Non-Veg" />


        <TextView
            android:id="@+id/tv_dish_spice_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_detail_card"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:textColor="#FD892D"
            android:textSize="16sp"
            tools:text="🌶️🌶️ Medium" />
    </LinearLayout>


    <LinearLayout
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:id="@+id/linear_layout_calories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linear_layout_detail_tags"
        app:layout_constraintEnd_toStartOf="@id/linear_layout_rating">

        <TextView
            android:textColor="#000"
            android:textStyle="bold"
            android:textSize="56sp"
            android:id="@+id/tv_calories_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="680" />

        <TextView
            android:textColor="#333"
            android:textSize="18sp"
            android:id="@+id/tv_calories_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/tv_calories_value"
            app:layout_constraintTop_toBottomOf="@id/tv_calories_value"
            tools:text="Calories" />

    </LinearLayout>


    <LinearLayout
        android:gravity="center"
        android:id="@+id/linear_layout_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/linear_layout_calories"
        app:layout_constraintTop_toTopOf="@id/linear_layout_calories">

        <TextView
            android:textStyle="bold"
            android:textColor="#000"
            android:textSize="56sp"
            android:id="@+id/tv_rating_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_calories_value"
            app:layout_constraintTop_toTopOf="@id/tv_calories_value"
            tools:text="4.8" />

        <TextView
            android:id="@+id/tv_rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/tv_rating_value"
            app:layout_constraintTop_toBottomOf="@id/tv_rating_value"
            tools:text="Rating" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>